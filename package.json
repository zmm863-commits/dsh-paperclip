{
  "name": "dsh-paperclip",
  "version": "0.2.5",
  "description": "DSH Web GUI paperclip button: a single 📎 button in the composer that opens a file picker and drops file content into the textarea.",
  "type": "module",
  "license": "MIT",
  "author": "zmm863-commits",
  "homepage": "https://github.com/zmm863-commits/dsh-paperclip",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmm863-commits/dsh-paperclip.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "paperclip",
    "file-upload",
    "composer"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node build.mjs",
    "watch": "tsdown --config tsdown.config.ts --watch",
    "test": "node scripts/smoke-client.mjs"
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-cordis",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "guided",
      "adapter": "third-party",
      "failurePolicy": "manual",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "immediate",
      "dispose": "unknown"
    },
    "permissions": [
      "fs:read",
      "fs:write",
      "ui:inject"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.0-rc.6"
      ]
    },
    "capability": {
      "id": "paperclip-inserts-file",
      "kind": "ui",
      "invocation": "打开 DSH Web 界面，点击输入框右侧的 📎，选择一个文件",
      "expected": "弹出文件选择器（支持拖拽），所选文件内容插入输入框文本"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  }
}
